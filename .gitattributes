# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Shell scripts must use LF
*.sh text eol=lf
gradlew text eol=lf

# Windows batch files must use CRLF
*.bat text eol=crlf
gradlew.bat text eol=crlf

# Java source
*.java text eol=lf
*.json text eol=lf
*.md text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.txt text eol=lf
